{# Standalone layout with no site chrome (no menu, flash messages, header or scripts).
   Keeps the stylesheets so document classes (tables, alignment) render, and is meant
   for printable documents such as invoices. #}
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <title>{% block title %}{% endblock %} | {{ app.currentSite.title }}</title>
    {% include "layout:_assets_css.html.twig" %}
  </head>
  <body>
    <div class="container">
      {% block main %}{% endblock %}
    </div>
  </body>
</html>
