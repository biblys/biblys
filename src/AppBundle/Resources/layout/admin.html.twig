<html lang="fr">
  <head>
    {{ app.metaTags|raw }}
    <title>
      {% block title %}{% endblock %} | Administration | {{ app.currentSite.title }}
    </title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {% include "layout:_assets_css.html.twig" %}
  </head>
  <body>
    {% include "layout:_overall_menu.html.twig" %}

    <div class="container">
      <nav class="navbar navbar-light bg-light position-sticky" style="top: 48px">
        <a class="navbar-brand" href="{{ path("main_admin") }}">
          Administration {{ app.currentSite.title }}
        </a>
        <a href="/" class="btn btn-outline-danger">Quitter</a>
      </nav>

      {% include "layout:_flash_messages.html.twig" %}

      <main class="mt-4 mb-5">
        {% block main %}{% endblock %}
      </main>
    </div>

    {% include "layout:_assets_js.html.twig" %}
  </body>
</html>