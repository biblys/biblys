{% extends "layout:admin.html.twig" %}

{% block title %}
  Liens du billet &laquo; {{ post.title }} &raquo;
{% endblock %}

{% block main %}

  <a href="{{ path("posts_admin") }}">
    <i class="fa-solid fa-newspaper"></i>
    Billets de blog
  </a>

  <h1>Liens du billet</h1>

  <p>
    <a href="{{ path("post_show", { slug: post.url }) }}">
      {{ post.title }}
    </a>
  </p>

  <h2 class="mt-4">Articles liés</h2>

  <table class="table table-striped mt-4">
    <thead>
    <tr>
      <th>Id</th>
      <th>Titre</th>
      <th>Type</th>
      <th></th>
    </tr>
    </thead>
    <tbody>
    {% for link in article_links %}
      <tr>
        <td>{{ link.article.id }}</td>
        <td>{{ link.article.title }}</td>
        <td>{{ link.article.type.name }}</td>
        <td>
          <form method="post" action="{{ path('post_articles_unlink', { id: post.id, articleId: link.article.id }) }}">
            <button type="submit" class="btn btn-danger btn-sm" title="Délier l'article">
              <i class="fa-solid fa-chain-broken"></i>
            </button>
          </form>
        </td>
      </tr>
    {% else %}
      <tr>
        <td colspan="4">Aucun article lié à ce billet.</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  <form id="add-country-form" action="{{ path('post_articles_link', { id: post.id }) }}" method="post">
    {% include "AppBundle:Utils:_entity-search-field.html.twig" with {
      query_url: "/pages/adm_article_search",
      label: "Ajouter un article lié…",
      autofocus: true,
      required: true,
      input_name: "article_id",
      submit_form: true,
      autoload: true,
    } %}
  </form>

  <h2 class="mt-5">Contributeurs liés</h2>

  <table class="table table-striped mt-4">
    <thead>
    <tr>
      <th>Id</th>
      <th>Nom</th>
      <th></th>
    </tr>
    </thead>
    <tbody>
    {% for people in linked_people %}
      <tr>
        <td>{{ people.id }}</td>
        <td>{{ people.fullName }}</td>
        <td>
          <form method="post" action="{{ path('post_people_unlink', { id: post.id, peopleId: people.id }) }}">
            <button type="submit" class="btn btn-danger btn-sm" title="Délier le contributeur">
              <i class="fa-solid fa-chain-broken"></i>
            </button>
          </form>
        </td>
      </tr>
    {% else %}
      <tr>
        <td colspan="3">Aucun contributeur lié à ce billet.</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  <form id="add-people-form" action="{{ path('post_people_link', { id: post.id }) }}" method="post">
    {% include "AppBundle:Utils:_entity-search-field.html.twig" with {
      field_id: "people-search-field",
      query_url: "/pages/article_people_search",
      label: "Ajouter un contributeur lié…",
      required: true,
      input_name: "people_id",
      submit_form: true,
      autoload: true,
    } %}
  </form>
{% endblock %}
