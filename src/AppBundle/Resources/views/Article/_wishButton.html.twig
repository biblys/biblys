<button
  type="button"
  data-wish="{{ article.id }}"
  class="btn btn-outline-secondary wish-button event"
  aria-label="{% if article.isInWishList() %}Retirer de mes envies{% else %}Ajouter à mes envies{% endif %}"
  title="{% if article.isInWishList() %}Retirer de mes envies{% else %}Ajouter à mes envies{% endif %}"
>
  {% if article.isInWishList() %}
    <i class="fa-solid fa-heart red"></i>
  {% else %}
    <i class="fa-regular fa-heart"></i>
  {% endif %}
</button>
