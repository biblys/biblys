{% set alertButtonLabel = article.isinAlerts() ? "Retirer de mes alertes" : "Créer une alerte" %}

<button
  type="button"
  data-alert="{{ article.id }}"
  class="btn btn-outline-secondary alert-button event"
  {% if hideLabel is defined %}
    aria-label="{{ alertButtonLabel }}"
    title="{{ alertButtonLabel }}"
  {% endif %}
>
  {% if article.isinAlerts() %}
    <i class="fa-solid fa-bell orange"></i>
  {% else %}
    <i class="fa-regular fa-bell"></i>
  {% endif %}
  {% if hideLabel is not defined %}
    <span class="alert-button-text">
      {% if label is defined %}
        {{ label }}
      {% else %}
        {{ alertButtonLabel }}
      {% endif %}
    </span>
  {% endif %}
</button>
