{% extends "layout:print.html.twig" %}

{% block title %}{{ page_title }}{% endblock %}

{% block main %}
    {% set colspan = is_shop ? 3 : 2 %}

    <div class="float-right">
        <h3>{{ order.title }} {{ order.firstname }} {{ order.lastname }}</h3>
        <p>
            {{ order.address1 }}<br>
            {% if order.address2 %}{{ order.address2 }}<br>{% endif %}
            {{ order.postalcode }} {{ order.city }}<br>
            {{ order.countryName }}
        </p>
        <p>{{ order.email }}</p>
    </div>

    <h3>{{ site_title }}<br>{{ site_address|replace({'|': '<br>'})|raw }}</h3>

    <h2>{{ page_title }}</h2>

    <br>
    <table class="table invoice-table">
        <thead>
            <tr>
                <th>Ref.</th>
                <th>Articles</th>
                {% if is_shop %}<th>État</th>{% endif %}
                <th>Prix</th>
            </tr>
        </thead>
        <tbody>
            {% for line in lines %}
                <tr>
                    <td class="center">{{ line.id }}</td>
                    <td>
                        <strong>{{ line.title }}</strong><br>
                        coll. {{ line.collectionName }}{% if line.number %} n° {{ line.number }}{% endif %}
                    </td>
                    {% if is_shop %}<td class="center">{{ line.condition }}</td>{% endif %}
                    <td class="right">{{ line.price|currency(true)|raw }}</td>
                </tr>
            {% endfor %}
        </tbody>
        <tfoot>
            <tr>
                <th colspan="{{ colspan }}" class="right">Articles :</th>
                <th class="right">{{ article_count }}</th>
            </tr>
            {% if total_weight > 0 %}
                <tr>
                    <th colspan="{{ colspan }}" class="right">Poids :</th>
                    <th class="right">{{ (total_weight / 1000)|round(2)|replace({'.': ','}) }}&nbsp;kg</th>
                </tr>
            {% endif %}
            <tr>
                <th colspan="{{ colspan }}" class="right">Frais de port ({{ order.shippingMode }}) :</th>
                <th class="right">{{ order.shippingCost|currency(true)|raw }}</th>
            </tr>
            {% if total_tva %}
                <tr>
                    <th colspan="{{ colspan }}" class="right">Total H.T. :</th>
                    <th class="right">{{ total_ht|currency(true)|raw }}</th>
                </tr>
                <tr>
                    <th colspan="{{ colspan }}" class="right">T.V.A. :</th>
                    <th class="right">{{ total_tva|currency(true)|raw }}</th>
                </tr>
            {% endif %}
            <tr>
                <th colspan="{{ colspan }}" class="right">Total T.T.C.&nbsp;:</th>
                <th class="right">{{ (order.amount + order.shippingCost)|currency(true)|raw }}</th>
            </tr>
        </tfoot>
    </table>

    {% if not has_tva %}
        <p class="center"><strong>TVA non applicable en application de l'article 293 B du CGI.</strong></p><br>
    {% endif %}

    {% if payment %}
        <p class="center">Règlement effectué le {{ payment.date }} par {{ payment.mode }}.</p><br>
    {% endif %}

    {% if invoice_notice %}
        <p class="text-center">{{ invoice_notice|replace({'\\n': '<br>'})|raw }}</p>
    {% endif %}
{% endblock %}
