{% extends "layout:base.html.twig" %}

{% block title %}
  Connexion
{% endblock %}

{% block main %}
  <div class="container my-4" style="max-width: 480px;">
    <h1>
      <span class="d-block h4">Connexion ou création de votre</span>
      compte {{ app.currentSite.site.domain }}
    </h1>

    <form class="my-4" method="post" action="{{ path("user_send_login_email") }}">
      <input type="hidden" name="return_url" value="{{ returnUrl }}" />
      <input type="text" name="username" class="login-username-field" aria-label="Ne pas remplir" />

      <div class="form-group">
        <label for="login-email">Votre adresse e-mail</label>
        <input
          id="login-email"
          class="form-control"
          type="email"
          name="email"
          autocomplete="email"
          aria-describedby="login-email-help"
          required
        />
        <small id="login-email-help" class="form-text text-muted">
          Vous recevrez un lien pour vous connecter ou créer votre compte.
        </small>
      </div>

      <button class="btn btn-block btn-primary" type="submit">Continuer</button>
    </form>

    {% if loginWithAxysUrl %}
      <div class="d-flex align-items-center my-4">
        <hr class="flex-grow-1" />
        <span class="mx-3 font-weight-bold">OU</span>
        <hr class="flex-grow-1" />
      </div>

      <h2 class="h4">Utiliser Axys</h2>
      <p>
        Axys est un autre moyen d'accéder à votre compte {{ app.currentSite.title }}.
        Utilisez Axys pour vous connecter en un clic sur de nombreux sites de
        librairies et de maisons d'édition.
      </p>

      <p class="mb-2">
        <a href="{{ loginWithAxysUrl }}" rel="nofollow" class="btn btn-info">
          <img src="/assets/images/axys.svg" alt="" role="presentation" width="16" height="16" />
          S'identifier avec Axys
        </a>
      </p>

      <p>
        <a href="https://axys.me/a-propos">
          Qu'est-ce que Axys ?
          <span class="fa fa-external-link ml-1" aria-hidden="true"></span>
        </a>
      </p>
    {% endif %}
  </div>

{% endblock %}
