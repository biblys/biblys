{% extends "layout:base.html.twig" %}

{% block title %}
  Mon compte {{ app.currentSite.site.title }}
{% endblock %}

{% block main %}
  <h1>Mon compte</h1>
  <p class="text-muted mb-4">Connecté avec {{ user_email }}</p>

  <section class="mb-5">
    <h2 class="h6 text-uppercase text-muted mb-2">Adresse e-mail</h2>
    <form action="{{ path('user_request_email_update') }}" method="post" style="max-width: 28rem;">
      <div class="input-group">
        <input type="email" class="form-control" id="new_email" name="new_email"
               value="{{ user_email }}" aria-label="Adresse e-mail">
        <div class="input-group-append">
          <button type="submit" class="btn btn-primary">Modifier</button>
        </div>
      </div>
    </form>
  </section>

  <nav aria-label="Menu du compte" style="max-width: 28rem;">
    <div class="list-group list-group-flush">
      {% if app.currentSite.hasOptionEnabled("wishlist") %}
        <a href="/pages/log_mywishes" class="list-group-item list-group-item-action d-flex align-items-center py-3">
          <span class="fa fa-heart text-muted mr-3" style="width: 1.25rem;"></span>
          Mes envies
          <i class="fa-solid fa-chevron-right ml-auto text-muted small"></i>
        </a>
      {% endif %}

      {% if app.currentSite.hasOptionEnabled("alerts") %}
        <a href="/pages/log_myalerts" class="list-group-item list-group-item-action d-flex align-items-center py-3">
          <span class="fa fa-bell text-muted mr-3" style="width: 1.25rem;"></span>
          Mes alertes
          <i class="fa-solid fa-chevron-right ml-auto text-muted small"></i>
        </a>
      {% endif %}

      <a href="{{ path("user_orders") }}" class="list-group-item list-group-item-action d-flex align-items-center py-3">
        <span class="fa-solid fa-box text-muted mr-3" style="width: 1.25rem;"></span>
        Mes commandes
        <i class="fa-solid fa-chevron-right ml-auto text-muted small"></i>
      </a>

      {% if app.currentSite.hasOptionEnabled("show_elibrary") %}
        <a href="{{ path('user_library') }}" class="list-group-item list-group-item-action d-flex align-items-center py-3">
          <span class="fa fa-book text-muted mr-3" style="width: 1.25rem;"></span>
          Ma bibliothèque
          <i class="fa-solid fa-chevron-right ml-auto text-muted small"></i>
        </a>
      {% endif %}

      {% if app.currentUser.hasPublisherRight %}
        <a href="/pages/log_dashboard" class="list-group-item list-group-item-action d-flex align-items-center py-3">
          <span class="fa fa-home text-muted mr-3" style="width: 1.25rem;"></span>
          Gérer ma maison d'édition
          <i class="fa-solid fa-chevron-right ml-auto text-muted small"></i>
        </a>
      {% endif %}

      {% if has_axys_method %}
        <a href="https://axys.me" rel="nofollow" class="list-group-item list-group-item-action d-flex align-items-center py-3">
          <span class="fa fa-key text-muted mr-3" style="width: 1.25rem;"></span>
          Mon compte Axys
          <i class="fa-solid fa-chevron-right ml-auto text-muted small"></i>
        </a>
      {% endif %}

      <a href="{{ path("user_logout") }}" class="list-group-item list-group-item-action d-flex align-items-center py-3 text-danger">
        <span class="fa fa-sign-out mr-3" style="width: 1.25rem;"></span>
        Déconnexion
      </a>
    </div>
  </nav>
{% endblock %}